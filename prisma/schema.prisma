generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String   @id @default(cuid())
  name     String?
  email    String   @unique
  phone    String?
  password String?
  role     UserRole @default(CUSTOMER)

  emailVerified       DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings        Booking[]
  cargoRequests   CargoRequest[]
  charterRequests CharterRequest[]
}

model Booking {
  id                      String        @id @default(cuid())
  tripType                TripType      @default(ROUND_TRIP)
  departureDate           DateTime
  returnDate              DateTime?
  passengersCount         Int

  customerName            String
  customerEmail           String
  customerPhone           String?

  airlineName             String?
  flightNumber            String?
  flightOfferId           String?

  baseFare                Decimal?      @db.Decimal(10, 2)
  taxes                   Decimal?      @db.Decimal(10, 2)
  serviceFee              Decimal?      @db.Decimal(10, 2)

  // Review / checkout
  travelProtection        Boolean       @default(false)
  travelProtectionAmount  Decimal?      @db.Decimal(10, 2)

  promoCode               String?
  discountAmount          Decimal?      @db.Decimal(10, 2)

  termsAccepted            Boolean       @default(false)
  termsAcceptedAt          DateTime?

  totalAmount             Decimal?      @db.Decimal(10, 2)
  currency                String        @default("USD")

  status                  BookingStatus @default(DRAFT)
  paymentStatus           PaymentStatus @default(PENDING)
  reservationExpiresAt    DateTime?

  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  airlineCode             String?
  bookingCode             String        @unique
  destinationCity         String?
  destinationCode         String
  originCity              String?
  originCode              String

  provider                String        @default("DUFFEL")

  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?

  scheduleId              String
  userId                  String?

  schedule                FlightSchedule @relation(fields: [scheduleId], references: [id])
  user                    User?          @relation(fields: [userId], references: [id])

  passengers              Passenger[]
  payments                Payment[]
  seats                   Seat[]

  @@index([scheduleId])
}

model Passenger {
  id              String    @id @default(cuid())
  bookingId       String
  firstName       String
  lastName        String
  dateOfBirth     DateTime?
  nationality     String?
  passportNumber  String?
  passportExpiry  DateTime?
  gender          String?
  middleName      String?
  passportCountry String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  seat Seat?
}

model Payment {
  id          String        @id @default(cuid())
  bookingId   String
  amount      Decimal       @db.Decimal(10, 2)
  currency    String        @default("USD")
  status      PaymentStatus @default(PENDING)
  provider    String        @default("STRIPE")
  providerRef String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Flight {
  id              String   @id @default(cuid())
  flightCode      String   @unique
  airlineName     String   @default("SkyBridge Air")
  aircraftName    String?
  originCode      String
  originCity      String?
  destinationCode String
  destinationCity String?
  departureDate   DateTime
  departureTime   String
  arrivalTime     String?
  duration        String?
  seatsAvailable  Int      @default(0)
  price           Decimal  @db.Decimal(10, 2)
  currency        String   @default("USD")
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CargoRequest {
  id             String        @id @default(cuid())
  fullName       String
  email          String
  phone          String
  fromCity       String
  toCity         String
  description    String
  status         RequestStatus @default(NEW)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  adminNotes     String?
  cargoType      CargoType     @default(OTHER)
  dimensions     String?
  estimatedValue Decimal?      @db.Decimal(10, 2)
  fromAddress    String?
  preferredDate  DateTime?
  requestCode    String        @unique
  toAddress      String?
  userId         String?
  weight         Decimal?      @db.Decimal(10, 2)
  user           User?         @relation(fields: [userId], references: [id])
}

model CharterRequest {
  id              String        @id @default(cuid())
  fullName        String
  email           String
  phone           String
  message         String?
  status          RequestStatus @default(NEW)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  adminNotes      String?
  aircraftType    String?
  budgetRange     String?
  departureCity   String
  departureDate   DateTime
  destinationCity String
  passengersCount Int
  requestCode     String        @unique
  returnDate      DateTime?
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])
}

model ContactMessage {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  phone     String?
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum UserRole {
  CUSTOMER
  ADMIN
  STAFF
}

enum TripType {
  ONE_WAY
  ROUND_TRIP
  MULTI_CITY
}

enum BookingStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  CONFIRMED
  CHECKED_IN
  TICKETED
  BOARDED
  COMPLETED
  CANCELLED
  REFUNDED
  FAILED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum RequestStatus {
  NEW
  CONTACTED
  QUOTED
  CLOSED
  IN_REVIEW
  ACCEPTED
  CANCELLED
}

enum CargoType {
  DOCUMENTS
  BOX
  BARREL
  PALLET
  OTHER
}

// ==========================================================
// AIRLINE OPERATIONS (V2)
// Append below your existing schema
// ==========================================================

enum AircraftStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
}

enum FlightScheduleStatus {
  SCHEDULED
  BOARDING
  DELAYED
  DEPARTED
  ARRIVED
  CANCELLED
}

enum CabinClass {
  ECONOMY
  PREMIUM_ECONOMY
  BUSINESS
  FIRST
}

enum SeatClass {
  ECONOMY
  BUSINESS
  FIRST
}

enum SeatStatus {
  AVAILABLE
  RESERVED
  BOOKED
}

model Airline {
  id String @id @default(cuid())

  name     String
  iataCode String  @unique
  icaoCode String? @unique

  logoUrl String?
  website String?

  supportEmail String?
  supportPhone String?

  country String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aircraft Aircraft[]
  routes   FlightRoute[]

  @@index([country])
}

model Airport {
  id String @id @default(cuid())

  iataCode String  @unique
  icaoCode String? @unique

  name    String
  city    String
  state   String?
  country String

  timezone String

  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  originRoutes      FlightRoute[] @relation("OriginAirport")
  destinationRoutes FlightRoute[] @relation("DestinationAirport")

  @@index([city])
  @@index([country])
}

model Aircraft {
  id String @id @default(cuid())

  airlineId String

  registrationNumber String @unique

  manufacturer String

  model String

  capacity Int

  economySeats Int

  premiumSeats Int @default(0)

  businessSeats Int

  firstClassSeats Int

  status AircraftStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  airline Airline @relation(fields: [airlineId], references: [id])

  schedules FlightSchedule[]

  @@index([airlineId])
}

model FlightRoute {
  id String @id @default(cuid())

  airlineId    String
  routeCode    String @unique
  flightNumber String

  originAirportId      String
  destinationAirportId String

  estimatedDuration Int
  distanceKm        Int?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  airline Airline @relation(fields: [airlineId], references: [id])

  originAirport Airport @relation("OriginAirport", fields: [originAirportId], references: [id])

  destinationAirport Airport @relation("DestinationAirport", fields: [destinationAirportId], references: [id])

  schedules FlightSchedule[]

  @@index([airlineId])
  @@index([originAirportId])
  @@index([destinationAirportId])
}

model FlightSchedule {
  id String @id @default(cuid())

  routeId    String
  aircraftId String

  departureTime DateTime
  arrivalTime   DateTime

  availableSeats Int
  baseFare       Decimal @db.Decimal(10, 2)

  // Airport operation information
  departureTerminal String?
  departureGate     String?
  arrivalTerminal   String?
  arrivalGate       String?

  status FlightScheduleStatus @default(SCHEDULED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  route    FlightRoute @relation(fields: [routeId], references: [id])
  aircraft Aircraft    @relation(fields: [aircraftId], references: [id])

  seats    Seat[]
  bookings Booking[]
}

model Seat {
  id String @id @default(cuid())

  scheduleId  String
  bookingId   String?
  passengerId String? @unique

  seatNumber String
  seatClass  SeatClass
  status     SeatStatus @default(AVAILABLE)
  price      Decimal    @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedule  FlightSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  booking   Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  passenger Passenger?     @relation(fields: [passengerId], references: [id], onDelete: SetNull)

  @@unique([scheduleId, seatNumber])
  @@index([bookingId])
  @@index([status])
}
